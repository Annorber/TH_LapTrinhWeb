@model TH_LTW_Buoi02.Models.Product

@{
    ViewData["Title"] = "Add Product";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white py-3">
                <h4 class="mb-0 fw-bold"><i class="bi bi-plus-circle me-2"></i>Thêm sản phẩm mới</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Add" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row mb-3">
                        <div class="col-md-6 form-group">
                            <label asp-for="Name" class="form-label fw-semibold">Tên sản phẩm</label>
                            <input asp-for="Name" class="form-control" placeholder="Nhập tên sản phẩm..." />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 form-group">
                            <label asp-for="Price" class="form-label fw-semibold">Giá bán (VNĐ)</label>
                            <input asp-for="Price" class="form-control" type="number" step="0.01" placeholder="Nhập giá..." />
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6 form-group">
                            <label asp-for="CategoryId" class="form-label fw-semibold">Danh mục</label>
                            <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select">
                                <option value="">-- Chọn danh mục --</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 form-group">
                            <label asp-for="ImageUrl" class="form-label fw-semibold">Hình ảnh đại diện (Chính)</label>
                            <input type="file" name="imageUrl" id="imageUrl" class="form-control" accept="image/*" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-12 form-group">
                            <label class="form-label fw-semibold">Hình ảnh mô tả phụ khác (Chọn nhiều ảnh)</label>
                            <input type="file" name="images" id="multipleImagesInput" class="form-control" multiple accept="image/*" />
                            <div class="form-text text-muted small mt-1">
                                <i class="bi bi-info-circle me-1"></i>Mẹo: Hãy nhấn giữ phím <strong>Ctrl</strong> (hoặc <strong>Cmd</strong> trên Mac) để chọn nhiều ảnh cùng lúc.
                            </div>
                            <div id="multipleImagesPreview" class="row g-2 mt-2"></div>
                        </div>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="Description" class="form-label fw-semibold">Mô tả sản phẩm</label>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="Nhập mô tả sản phẩm..."></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle me-2"></i>Thêm mới</button>
                        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-2"></i>Quay lại</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Preview main image
        document.getElementById('imageUrl').addEventListener('change', function (event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    // Create preview on the fly if needed, or simply let the user select
                };
                reader.readAsDataURL(file);
            }
        });

        // Preview multiple sub-images
        document.getElementById('multipleImagesInput').addEventListener('change', function (event) {
            const files = event.target.files;
            const previewContainer = document.getElementById('multipleImagesPreview');
            previewContainer.innerHTML = ''; // Clear old previews
            
            if (files && files.length > 0) {
                for (let i = 0; i < files.length; i++) {
                    const file = files[i];
                    const reader = new FileReader();
                    
                    reader.onload = function (e) {
                        const col = document.createElement('div');
                        col.className = 'col-3 col-sm-2 text-center';
                        col.innerHTML = `
                            <div class="border rounded p-1 bg-light d-flex align-items-center justify-content-center" style="height: 60px;">
                                <img src="${e.target.result}" class="img-fluid h-100" style="object-fit: contain;" />
                            </div>
                        `;
                        previewContainer.appendChild(col);
                    }
                    reader.readAsDataURL(file);
                }
            }
        });
    </script>
}

