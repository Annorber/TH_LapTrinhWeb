@model TH_LTW_Buoi02.Models.Product

@{
    ViewData["Title"] = "Delete Product";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-0 border-danger">
            <div class="card-header bg-danger text-white py-3">
                <h4 class="mb-0 fw-bold"><i class="bi bi-exclamation-triangle me-2"></i>Xác nhận xóa sản phẩm</h4>
            </div>
            <div class="card-body p-4 text-center">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="@Model.Name" class="img-thumbnail mb-3" style="max-height: 150px; object-fit: contain;" />
                }
                <p class="fs-5 mb-4">Bạn có chắc chắn muốn xóa sản phẩm <strong>@Model.Name</strong>?</p>
                <p class="text-danger small mb-4"><i class="bi bi-info-circle me-1"></i>Hành động này không thể hoàn tác.</p>
                
                <form asp-action="DeleteConfirmed" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-center gap-2">
                        <button type="submit" class="btn btn-danger px-4"><i class="bi bi-trash me-2"></i>Xóa</button>
                        <a asp-action="Index" class="btn btn-outline-secondary px-4"><i class="bi bi-x-circle me-2"></i>Hủy bỏ</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
