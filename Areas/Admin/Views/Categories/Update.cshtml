@model TH_LTW_Buoi02.Models.Category

@{
    ViewData["Title"] = "Edit Category";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-warning text-dark py-3">
                <h4 class="mb-0 fw-bold"><i class="bi bi-pencil-square me-2"></i>Chỉnh sửa danh mục</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Update" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="Id" />
                    
                    <div class="form-group mb-4">
                        <label asp-for="Name" class="form-label fw-semibold">Tên danh mục</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="ImageUrl" class="form-label fw-semibold">Đường dẫn ảnh Logo (URL)</label>
                        <input asp-for="ImageUrl" class="form-control" />
                        <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                        @if(!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <div class="mt-2">
                                <label class="form-label text-muted small">Logo hiện tại:</label><br/>
                                <img src="@Model.ImageUrl" style="max-height: 80px; object-fit: contain; border-radius: 50%; border: 1px solid #ddd; padding: 5px;" />
                            </div>
                        }
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning"><i class="bi bi-save me-2"></i>Lưu thay đổi</button>
                        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-2"></i>Quay lại</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
