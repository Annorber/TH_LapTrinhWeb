@model IEnumerable<TH_LTW_Buoi02.Models.Category>

@{
    ViewData["Title"] = "Danh mục sản phẩm";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="page-header-title">Danh mục sản phẩm</h2>
    <a asp-action="Add" class="btn btn-premium-primary"><i class="bi bi-plus-circle me-2"></i>Thêm danh mục mới</a>
</div>

<div class="card premium-table-card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table premium-table align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4" style="width: 15%;">Mã</th>
                        <th style="width: 20%;">Logo</th>
                        <th style="width: 40%;">Tên danh mục</th>
                        <th class="text-end pe-4" style="width: 30%;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="3" class="text-center py-4 text-muted">Chưa có danh mục nào. Hãy thêm mới!</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var category in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <span class="badge-id">#@category.Id</span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(category.ImageUrl))
                                    {
                                        <img src="@category.ImageUrl" alt="@category.Name" style="height: 40px; width: 40px; object-fit: contain; border-radius: 50%; background-color: #f8f9fa; padding: 2px;" />
                                    }
                                    else
                                    {
                                        <span class="text-muted small fst-italic">Trống</span>
                                    }
                                </td>
                                <td class="fw-semibold" style="color: #0f172a !important;">@category.Name</td>
                                <td class="text-end pe-4">
                                    <div class="btn-action-group justify-content-end">
                                        <a asp-action="Display" asp-route-id="@category.Id" class="btn-action btn-action-view"><i class="bi bi-eye"></i> Xem</a>
                                        <a asp-action="Update" asp-route-id="@category.Id" class="btn-action btn-action-edit"><i class="bi bi-pencil"></i> Sửa</a>
                                        <a asp-action="Delete" asp-route-id="@category.Id" class="btn-action btn-action-delete"><i class="bi bi-trash"></i> Xóa</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

