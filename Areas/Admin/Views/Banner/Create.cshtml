@model TH_LTW_Buoi02.Models.Banner
@{
    ViewData["Title"] = "Thêm Mới Banner";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0"><i class="bi bi-plus-circle"></i> Thêm Mới Banner</h5>
    </div>
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="row">
                <div class="col-md-8">
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-bold">Tiêu đề Banner <span class="text-danger">*</span></label>
                        <input asp-for="Title" class="form-control" placeholder="Nhập tiêu đề (VD: Khuyến mãi mùa hè)" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ImageUrl" class="form-label fw-bold">Đường dẫn Hình ảnh (URL)</label>
                        <input asp-for="ImageUrl" class="form-control" placeholder="Nhập link ảnh (VD: https://...)" />
                        <span asp-validation-for="ImageUrl" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Link" class="form-label fw-bold">Đường dẫn khi bấm vào (Link URL)</label>
                        <input asp-for="Link" class="form-control" placeholder="Khi khách bấm vào ảnh sẽ chuyển đến link nào?" />
                        <span asp-validation-for="Link" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Order" class="form-label fw-bold">Thứ tự hiển thị <span class="text-danger">*</span></label>
                        <input asp-for="Order" type="number" class="form-control" value="1" />
                        <span asp-validation-for="Order" class="text-danger"></span>
                        <div class="form-text">Số càng nhỏ hiển thị càng trước (1, 2, 3...)</div>
                    </div>

                    <div class="mt-4">
                        <button type="submit" class="btn btn-success"><i class="bi bi-save"></i> Lưu Banner</button>
                        <a asp-action="Index" class="btn btn-secondary ms-2"><i class="bi bi-arrow-left"></i> Quay lại danh sách</a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
