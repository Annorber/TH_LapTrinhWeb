@model IEnumerable<TH_LTW_Buoi02.Models.Banner>
@{
    ViewData["Title"] = "Quản Lý Banner";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="m-0 text-dark"><i class="bi bi-images me-2 text-primary"></i> Quản Lý Banner</h2>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Thêm Banner mới</a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <table class="table table-hover table-striped m-0">
            <thead class="table-dark">
                <tr>
                    <th style="width: 100px; text-align:center;">Thứ tự</th>
                    <th>Hình ảnh</th>
                    <th>Tiêu đề</th>
                    <th>Đường dẫn Link</th>
                    <th style="width: 150px; text-align:center;">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr class="align-middle">
                            <td class="text-center fw-bold text-muted">@item.Order</td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" alt="@item.Title" style="height: 60px; width: 150px; object-fit: cover; border-radius: 4px; border: 1px solid #ddd;" />
                                }
                                else
                                {
                                    <span class="text-muted fst-italic">Không có ảnh</span>
                                }
                            </td>
                            <td class="fw-bold">@item.Title</td>
                            <td><a href="@item.Link" target="_blank" class="text-decoration-none">@item.Link</a></td>
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning" title="Sửa"><i class="bi bi-pencil"></i></a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Xóa" onclick="return confirm('Bạn có chắc chắn muốn xóa Banner này không?');"><i class="bi bi-trash"></i></a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                            Chưa có banner nào. Hãy thêm banner mới!
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
