@model TH_LTW_Buoi02.Models.Banner
@{
    ViewData["Title"] = "Chỉnh Sửa Banner";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-warning text-dark">
        <h5 class="mb-0"><i class="bi bi-pencil-square"></i> Chỉnh Sửa Banner</h5>
    </div>
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="row">
                <div class="col-md-8">
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label fw-bold">Tiêu đề Banner <span class="text-danger">*</span></label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ImageUrl" class="form-label fw-bold">Đường dẫn Hình ảnh (URL)</label>
                        <input asp-for="ImageUrl" class="form-control" />
                        <span asp-validation-for="ImageUrl" class="text-danger"></span>
                        @if(!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <div class="mt-2">
                                <label class="form-label text-muted">Ảnh hiện tại:</label><br/>
                                <img src="@Model.ImageUrl" style="max-height: 150px; border-radius: 4px; border: 1px solid #ddd;" />
                            </div>
                        }
                    </div>

                    <div class="mb-3">
                        <label asp-for="Link" class="form-label fw-bold">Đường dẫn khi bấm vào (Link URL)</label>
                        <input asp-for="Link" class="form-control" />
                        <span asp-validation-for="Link" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Order" class="form-label fw-bold">Thứ tự hiển thị <span class="text-danger">*</span></label>
                        <input asp-for="Order" type="number" class="form-control" />
                        <span asp-validation-for="Order" class="text-danger"></span>
                    </div>

                    <div class="mt-4">
                        <button type="submit" class="btn btn-success"><i class="bi bi-save"></i> Cập nhật</button>
                        <a asp-action="Index" class="btn btn-secondary ms-2"><i class="bi bi-arrow-left"></i> Quay lại</a>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
