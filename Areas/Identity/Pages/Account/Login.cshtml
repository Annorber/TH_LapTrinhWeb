@page
@model TH_LTW_Buoi02.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Đăng nhập";
    Layout = null; // Dùng layout riêng toàn màn hình
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 36TH SHOP</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #ee4d2d; margin: 0; }
        .login-header { background-color: white; padding: 15px 0; }
        .login-header .container { display: flex; align-items: center; justify-content: space-between; }
        .logo-text { color: #ee4d2d; font-size: 24px; font-weight: bold; text-decoration: none; display: flex; align-items: center;}
        .logo-text i { font-size: 32px; margin-right: 10px; }
        .login-container { max-width: 1040px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; padding: 50px 20px; }
        .login-banner { flex: 1; text-align: center; color: white; display: flex; flex-direction: column; align-items: center; justify-content: center; padding-right: 50px; }
        .login-banner i { font-size: 150px; line-height: 1; margin-bottom: 20px; }
        .login-banner h1 { font-size: 48px; font-weight: bold; margin: 0; }
        .login-banner p { font-size: 24px; margin-top: 10px; }
        .login-box { width: 400px; background: white; border-radius: 4px; padding: 30px; box-shadow: 0 3px 10px rgba(0,0,0,0.1); }
        .login-box h2 { font-size: 20px; margin-bottom: 25px; color: #333; }
        .form-control { border-radius: 2px; padding: 12px; margin-bottom: 15px; border: 1px solid #e0e0e0; }
        .form-control:focus { border-color: #ee4d2d; box-shadow: none; }
        .btn-login { background-color: #ee4d2d; color: white; border: none; padding: 12px; width: 100%; border-radius: 2px; font-size: 16px; font-weight: 500; cursor: pointer; margin-bottom: 15px; text-transform: uppercase; }
        .btn-login:hover { background-color: #d73211; }
        .login-links { display: flex; justify-content: space-between; font-size: 13px; }
        .login-links a { color: #0055aa; text-decoration: none; }
        .divider { display: flex; align-items: center; text-align: center; color: #ccc; margin: 20px 0; font-size: 12px; }
        .divider::before, .divider::after { content: ''; flex: 1; border-bottom: 1px solid #eee; }
        .divider:not(:empty)::before { margin-right: .25em; }
        .divider:not(:empty)::after { margin-left: .25em; }
        .social-btns { display: flex; gap: 10px; }
        .btn-social { flex: 1; border: 1px solid #e0e0e0; padding: 8px; text-align: center; border-radius: 2px; text-decoration: none; color: #333; display: flex; align-items: center; justify-content: center; font-size: 14px; }
        .btn-social i { margin-right: 5px; font-size: 18px; }
        .register-link { text-align: center; margin-top: 25px; font-size: 14px; color: rgba(0,0,0,.26); }
        .register-link a { color: #ee4d2d; text-decoration: none; font-weight: 500; }
        footer { background: white; padding: 30px 0; border-top: 4px solid #ee4d2d; margin-top: 50px; height: 100vh;}
    </style>
</head>
<body>
    <header class="login-header">
        <div class="container">
            <a href="/" class="logo-text"><i class="bi bi-bag-fill"></i> 36TH SHOP Đăng Nhập</a>
            <a href="#" style="color: #ee4d2d; text-decoration: none; font-size: 14px;">Bạn cần giúp đỡ?</a>
        </div>
    </header>

    <div class="login-container">
        <div class="login-banner d-none d-md-flex">
            <i class="bi bi-bag-fill"></i>
            <h1>36TH SHOP</h1>
            <p>Nền tảng thương mại điện tử<br/>yêu thích ở Đông Nam Á & Đài Loan</p>
        </div>
        
        <div class="login-box">
            <h2>Đăng nhập</h2>
            
            <form id="account" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                
                <input asp-for="Input.Email" class="form-control" placeholder="Email / Tên đăng nhập" />
                <span asp-validation-for="Input.Email" class="text-danger small mb-3 d-block"></span>
                
                <input asp-for="Input.Password" type="password" class="form-control" placeholder="Mật khẩu" />
                <span asp-validation-for="Input.Password" class="text-danger small mb-3 d-block"></span>
                
                <button id="login-submit" type="submit" class="btn-login">Đăng Nhập</button>
                
                <div class="login-links">
                    <a href="#">Quên mật khẩu</a>
                    <a href="#">Đăng nhập với SMS</a>
                </div>
            </form>
            
            <div class="divider">HOẶC</div>
            
            <div class="social-btns">
                <a href="#" class="btn-social"><i class="bi bi-facebook text-primary"></i> Facebook</a>
                <a href="#" class="btn-social"><i class="bi bi-google text-danger"></i> Google</a>
            </div>
            
            <div class="register-link">
                Bạn mới biết đến 36TH SHOP? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Đăng ký</a>
            </div>
        </div>
    </div>
    
    <footer>
        <div class="container text-center text-muted" style="font-size: 13px;">
            &copy; 2026 36TH SHOP. Tất cả các quyền được bảo lưu.
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
