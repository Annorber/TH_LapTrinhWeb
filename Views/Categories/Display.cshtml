@model TH_LTW_Buoi02.Models.Category

@{
    ViewData["Title"] = "Category Details";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-info text-white py-3">
                <h4 class="mb-0 fw-bold"><i class="bi bi-info-circle me-2"></i>Chi tiết danh mục</h4>
            </div>
            <div class="card-body p-4">
                <div class="mb-3">
                    <span class="text-muted small d-block">Mã danh mục</span>
                    <strong class="fs-5">#@Model.Id</strong>
                </div>
                <div class="mb-4">
                    <span class="text-muted small d-block">Tên danh mục</span>
                    <strong class="fs-4">@Model.Name</strong>
                </div>
                
                <div class="d-flex gap-2">
                    <a asp-action="Update" asp-route-id="@Model.Id" class="btn btn-warning"><i class="bi bi-pencil me-2"></i>Chỉnh sửa</a>
                    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-2"></i>Quay lại</a>
                </div>
            </div>
        </div>
    </div>
</div>
