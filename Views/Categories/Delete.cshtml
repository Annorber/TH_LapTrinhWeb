@model TH_LTW_Buoi02.Models.Category

@{
    ViewData["Title"] = "Delete Category";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-0 border-danger">
            <div class="card-header bg-danger text-white py-3">
                <h4 class="mb-0 fw-bold"><i class="bi bi-exclamation-triangle me-2"></i>Xác nhận xóa danh mục</h4>
            </div>
            <div class="card-body p-4 text-center">
                <p class="fs-5 mb-4">Bạn có chắc chắn muốn xóa danh mục <strong>@Model.Name</strong>?</p>
                
                <form asp-action="DeleteConfirmed" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-center gap-2">
                        <button type="submit" class="btn btn-danger px-4"><i class="bi bi-trash me-2"></i>Xóa</button>
                        <a asp-action="Index" class="btn btn-outline-secondary px-4"><i class="bi bi-x-circle me-2"></i>Hủy bỏ</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
