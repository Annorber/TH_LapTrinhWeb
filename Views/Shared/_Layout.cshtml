<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SHOP</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TH_LTW_Buoi02.styles.css" asp-append-version="true" />
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-shop sticky-top mb-4">
        <div class="container">
            <a class="navbar-brand fw-bold d-flex align-items-center" asp-controller="Home" asp-action="Index">
                <div class="brand-avatar me-2">
                    <i class="bi bi-bag-fill"></i>
                </div>
                SHOP
            </a>
            <button class="navbar-toggler text-white" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon" style="filter: invert(1);"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Trang Chủ</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Product" asp-action="Index">Quản lý Sản Phẩm</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Categories" asp-action="Index">Quản lý Danh Mục</a></li>
                    <li class="nav-item"><a class="nav-link" href="~/Buoi01/index.html" target="_blank">Xem Buổi 01</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="container">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <!-- Footer -->
    <footer class="mt-5 border-top bg-white pt-5 pb-3">
        <div class="container">
            <div class="row text-center text-md-start">
                <div class="col-md-4 mb-4">
                    <h6 class="fw-bold text-dark mb-3">CHĂM SÓC KHÁCH HÀNG</h6>
                    <ul class="list-unstyled">
                        <li><a href="#" class="text-muted small">Trung Tâm Trợ Giúp</a></li>
                        <li><a href="#" class="text-muted small">Shop Blog</a></li>
                        <li><a href="#" class="text-muted small">Shop Mall</a></li>
                    </ul>
                </div>
                <div class="col-md-4 mb-4">
                    <h6 class="fw-bold text-dark mb-3">VỀ SHOP</h6>
                    <ul class="list-unstyled">
                        <li><a href="#" class="text-muted small">Giới Thiệu</a></li>
                        <li><a href="#" class="text-muted small">Tuyển Dụng</a></li>
                        <li><a href="#" class="text-muted small">Điều Khoản</a></li>
                    </ul>
                </div>
                <div class="col-md-4 mb-4">
                    <h6 class="fw-bold text-dark mb-3">THANH TOÁN</h6>
                    <div class="d-flex justify-content-center justify-content-md-start gap-3">
                        <i class="bi bi-credit-card fs-3 text-muted"></i>
                        <i class="bi bi-wallet2 fs-3 text-muted"></i>
                        <i class="bi bi-paypal fs-3 text-muted"></i>
                    </div>
                </div>
            </div>
            <hr>
            <div class="text-center mt-3">
                <p class="m-0 text-muted small">&copy; 2026 Shop. Tất cả các quyền được bảo lưu.</p>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
