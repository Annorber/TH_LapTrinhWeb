@model IEnumerable<TH_LTW_Buoi02.Models.Product>

@{
    ViewData["Title"] = "Danh sách sản phẩm";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="page-header-title">Danh sách sản phẩm</h2>
    <a asp-action="Add" class="btn btn-premium-primary"><i class="bi bi-plus-circle me-2"></i>Thêm sản phẩm mới</a>
</div>

<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
    @if (Model == null || !Model.Any())
    {
        <div class="col-12 text-center py-5">
            <p class="text-muted fs-5">Chưa có sản phẩm nào. Hãy thêm mới sản phẩm!</p>
        </div>
    }
    else
    {
        foreach (var product in Model)
        {
            var categoryClass = "category-badge-default";
            if (product.Category?.Name == "Điện thoại") categoryClass = "category-badge-phone";
            else if (product.Category?.Name == "Laptop") categoryClass = "category-badge-laptop";
            else if (product.Category?.Name == "Tai nghe" || product.Category?.Name == "Loa") categoryClass = "category-badge-audio";
            else if (product.Category?.Name == "Đồng hồ") categoryClass = "category-badge-watch";

            <div class="col">
                <div class="premium-card d-flex flex-column h-100">
                    <div class="premium-card-img-wrapper">
                        @if (!string.IsNullOrEmpty(product.ImageUrl))
                        {
                            <img src="@product.ImageUrl" alt="@product.Name" />
                        }
                        else
                        {
                            <div class="premium-card-img-fallback">
                                <i class="bi bi-image" style="font-size: 3rem;"></i>
                            </div>
                        }
                    </div>
                    <div class="card-body d-flex flex-column p-3">
                        <span class="category-badge @categoryClass mb-2 align-self-start">@(product.Category?.Name ?? "Chưa phân loại")</span>
                        <h5 class="card-title fw-semibold text-dark mb-2" style="font-size: 0.95rem; height: 2.5rem; overflow: hidden; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2;">@product.Name</h5>
                        <p class="price mb-3" style="color: var(--shop-orange); font-size: 1.15rem; font-weight: 700;">₫@product.Price.ToString("N0")</p>
                        
                        <div class="mt-auto pt-2 border-top d-flex gap-1 justify-content-between">
                            <a asp-action="Display" asp-route-id="@product.Id" class="btn-action btn-action-view flex-grow-1 text-center"><i class="bi bi-eye"></i> Xem</a>
                            <a asp-action="Update" asp-route-id="@product.Id" class="btn-action btn-action-edit flex-grow-1 text-center"><i class="bi bi-pencil"></i> Sửa</a>
                            <a asp-action="Delete" asp-route-id="@product.Id" class="btn-action btn-action-delete flex-grow-1 text-center"><i class="bi bi-trash"></i> Xóa</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

