@model TH_LTW_Buoi02.Models.Product
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Edit Product";
}

<div class="card shadow-sm border-0">
    <div class="card-header bg-warning text-dark py-3">
        <h4 class="mb-0 fw-bold"><i class="bi bi-pencil-square me-2"></i>Chỉnh sửa sản phẩm</h4>
    </div>
    <div class="card-body p-4">
        <form asp-action="Update" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="Id" />

            <div class="row">
                <!-- Left column: form fields -->
                <div class="col-md-8">
                    <div class="row mb-3">
                        <div class="col-md-6 form-group">
                            <label asp-for="Name" class="form-label fw-semibold">Tên sản phẩm</label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 form-group">
                            <label asp-for="Price" class="form-label fw-semibold">Giá bán (VNĐ)</label>
                            <input asp-for="Price" class="form-control" type="number" step="0.01" />
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6 form-group">
                            <label asp-for="CategoryId" class="form-label fw-semibold">Danh mục</label>
                            <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select"></select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 form-group">
                            <label asp-for="ImageUrl" class="form-label fw-semibold">Thay đổi hình đại diện (Chính)</label>
                            <input type="file" name="imageUrl" id="imageInput" class="form-control" accept="image/*" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-12 form-group">
                            <label class="form-label fw-semibold">Thêm hình ảnh phụ khác (Chọn nhiều ảnh)</label>
                            <input type="file" name="images" id="multipleImagesInput" class="form-control" multiple accept="image/*" />
                            <div class="form-text text-muted small mt-1">
                                <i class="bi bi-info-circle me-1"></i>Mẹo: Hãy nhấn giữ phím <strong>Ctrl</strong> (hoặc <strong>Cmd</strong> trên Mac) để chọn nhiều ảnh cùng lúc.
                            </div>
                            <div id="multipleImagesPreview" class="row g-2 mt-2"></div>
                        </div>
                    </div>

                    @if (Model.Images != null && Model.Images.Count > 0)
                    {
                        <div class="mb-4">
                            <label class="form-label fw-semibold d-block">Hình ảnh mô tả phụ hiện tại (Tích chọn để xóa):</label>
                            <div class="row g-2">
                                @foreach (var img in Model.Images)
                                {
                                    <div class="col-3 col-sm-2 text-center">
                                        <div class="border rounded p-1 bg-light d-flex align-items-center justify-content-center" style="height: 60px;">
                                            <img src="@img.Url" class="img-fluid h-100" style="object-fit: contain;" />
                                        </div>
                                        <div class="form-check d-flex justify-content-center mt-1">
                                            <input class="form-check-input" type="checkbox" name="deleteImages" value="@img.Id" id="del_@img.Id" />
                                            <label class="form-check-label ms-1 text-danger small" for="del_@img.Id">Xóa</label>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <div class="form-group mb-4">
                        <label asp-for="Description" class="form-label fw-semibold">Mô tả sản phẩm</label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning"><i class="bi bi-save me-2"></i>Lưu thay đổi</button>
                        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-2"></i>Quay lại</a>
                    </div>
                </div>

                <!-- Right column: image preview -->
                <div class="col-md-4 text-center border-start">
                    <div class="p-3">
                        <label class="form-label fw-semibold mb-3 d-block">Hình ảnh hiện tại / Xem trước</label>
                        <div class="border rounded p-2 bg-light d-flex align-items-center justify-content-center" style="height: 250px;">
                            @if (!string.IsNullOrEmpty(Model.ImageUrl))
                            {
                                <img src="@Model.ImageUrl" alt="Product Image" id="previewImage" class="img-fluid rounded" style="max-height: 100%; object-fit: contain;" />
                            }
                            else
                            {
                                <img src="" alt="Product Image" id="previewImage" class="img-fluid rounded d-none" style="max-height: 100%; object-fit: contain;" />
                                <div id="previewFallback" class="text-muted">
                                    <i class="bi bi-image" style="font-size: 3rem;"></i>
                                    <p class="small mb-0">Chưa có ảnh</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
    // Preview main image
    document.getElementById('imageInput').addEventListener('change', function (event) {
        const file = event.target.files[0];
        if (file) {
            const reader = new FileReader();
            reader.onload = function (e) {
                const img = document.getElementById("previewImage");
                const fallback = document.getElementById("previewFallback");
                
                img.src = e.target.result;
                img.classList.remove("d-none");
                
                if (fallback) {
                    fallback.classList.add("d-none");
                }
            };
            reader.readAsDataURL(file);
        }
    });

    // Preview multiple sub-images
    document.getElementById('multipleImagesInput').addEventListener('change', function (event) {
        const files = event.target.files;
        const previewContainer = document.getElementById('multipleImagesPreview');
        previewContainer.innerHTML = ''; // Clear old previews
        
        if (files && files.length > 0) {
            for (let i = 0; i < files.length; i++) {
                const file = files[i];
                const reader = new FileReader();
                
                reader.onload = function (e) {
                    const col = document.createElement('div');
                    col.className = 'col-3 col-sm-2 text-center';
                    col.innerHTML = `
                        <div class="border rounded p-1 bg-light d-flex align-items-center justify-content-center" style="height: 60px;">
                            <img src="${e.target.result}" class="img-fluid h-100" style="object-fit: contain;" />
                        </div>
                    `;
                    previewContainer.appendChild(col);
                }
                reader.readAsDataURL(file);
            }
        }
    });
</script>
