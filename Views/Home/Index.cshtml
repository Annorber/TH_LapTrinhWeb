@model IEnumerable<TH_LTW_Buoi02.Models.Product>

@{
    ViewData["Title"] = "Trang Chủ";
}

<!-- Banner Carousel -->
<div id="shopeeBanner" class="carousel slide mb-4" data-bs-ride="carousel">
    <div class="carousel-inner" style="border-radius: var(--shopee-radius);">
        @{
            var banners = ViewBag.Banners as IEnumerable<TH_LTW_Buoi02.Models.Banner>;
            var first = true;
            if (banners != null && banners.Any())
            {
                foreach (var banner in banners)
                {
                    <div class="carousel-item @(first ? "active" : "")">
                        @if(!string.IsNullOrEmpty(banner.Link))
                        {
                            <a href="@banner.Link">
                                <img src="@banner.ImageUrl" class="d-block w-100" style="height: 350px; object-fit: contain; background-color: #f4f6f9;" alt="@banner.Title">
                            </a>
                        }
                        else
                        {
                            <img src="@banner.ImageUrl" class="d-block w-100" style="height: 350px; object-fit: contain; background-color: #f4f6f9;" alt="@banner.Title">
                        }
                    </div>
                    first = false;
                }
            }
            else
            {
                <div class="carousel-item active">
                    <img src="https://cf.shopee.vn/file/vn-50009109-1a4cc2f00d8b4e7e9be1c54bb883b276" class="d-block w-100" style="height: 350px; object-fit: contain; background-color: #f4f6f9;" alt="Banner 1">
                </div>
            }
        }
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#shopeeBanner" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#shopeeBanner" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
    </button>
</div>

<!-- Categories Grid -->
<div class="shopee-category-container shadow-sm p-0 mb-4 bg-white mt-4">
    <div class="shopee-category-header p-3 mb-0 border-bottom text-muted" style="font-size: 16px;">DANH MỤC</div>
    <div class="d-flex overflow-auto" style="white-space: nowrap;">
        @{
            var categories = ViewBag.Categories as IEnumerable<TH_LTW_Buoi02.Models.Category>;
        }
        @if (categories != null)
        {
            foreach (var cat in categories)
            {
                <div style="width: 120px; flex-shrink: 0;" class="border-end border-bottom">
                    <a asp-action="Index" asp-route-categoryId="@cat.Id" class="shopee-category-item text-dark text-decoration-none d-flex flex-column align-items-center p-3 h-100" style="border: none;">
                        <div style="width: 70px; height: 70px; background-color: #f8f9fa; border-radius: 50%; display: flex; justify-content: center; align-items: center; margin-bottom: 15px;">
                            @{
                                var catImg = !string.IsNullOrEmpty(cat.ImageUrl) ? cat.ImageUrl : "https://cf.shopee.vn/file/687f3967b7c2fe6a134a2c11894eea4b_tn";
                            }
                            <img src="@catImg" style="width: 50px; height: 50px; object-fit: contain;" alt="@cat.Name" onerror="this.src='https://cf.shopee.vn/file/687f3967b7c2fe6a134a2c11894eea4b_tn';" />
                        </div>
                        <span style="font-size: 14px; text-align: center; white-space: normal; line-height: 1.2; font-weight: 400;">@cat.Name</span>
                    </a>
                </div>
            }
        }
    </div>
</div>

<!-- Daily Discover -->
<div class="shopee-daily-discover sticky-top" style="top: 100px; z-index: 10;">
    GỢI Ý HÔM NAY
</div>

<div class="row row-cols-2 row-cols-md-4 row-cols-lg-6 g-2 mb-4">
    @if (Model == null || !Model.Any())
    {
        <div class="col-12 text-center py-5 w-100">
            <p class="text-muted">Chưa có sản phẩm nào.</p>
        </div>
    }
    else
    {
        foreach (var product in Model)
        {
            <div class="col">
                <a asp-controller="Home" asp-action="Display" asp-route-id="@product.Id" class="shopee-product-card text-decoration-none text-dark">
                    @if (!string.IsNullOrEmpty(product.ImageUrl))
                    {
                        <img src="@product.ImageUrl" class="shopee-product-img" alt="@product.Name" />
                    }
                    else
                    {
                        <div class="shopee-product-img d-flex align-items-center justify-content-center bg-light text-muted">
                            <i class="bi bi-image" style="font-size: 2.5rem;"></i>
                        </div>
                    }
                    
                    <div class="shopee-product-info">
                        <div class="shopee-product-title">@product.Name</div>
                        <div class="d-flex justify-content-between align-items-end mt-2">
                            <div class="shopee-product-price">₫@product.Price.ToString("N0")</div>
                            <div class="text-muted" style="font-size: 10px; margin-bottom: 3px;">Đã bán 1,2k</div>
                        </div>
                    </div>
                </a>
            </div>
        }
    }
</div>

<div class="text-center mb-5">
    <button class="shopee-btn-outline-orange px-5 py-2">Xem Thêm</button>
</div>
