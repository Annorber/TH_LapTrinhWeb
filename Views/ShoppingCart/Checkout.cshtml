@model Order
@{
    ViewData["Title"] = "Thanh Toán";
    var cart = ViewBag.Cart as ShoppingCart;
}

<div class="container mb-5 pb-5">
    <div class="row">
        <div class="col-12">
            <!-- Delivery and Recipient Info Box -->
            <div class="bg-white p-4 rounded shadow-sm mb-4" style="border-top: 4px solid var(--shopee-orange);">
                <div class="d-flex align-items-center mb-4 text-orange">
                    <i class="bi bi-geo-alt-fill fs-4 me-2"></i>
                    <h5 class="m-0 fw-bold">Thông Tin Nhận Hàng</h5>
                </div>
                
                <form asp-action="Checkout" method="post" id="checkoutForm">
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label text-muted small fw-bold">Tên Người Nhận <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
                                <input asp-for="CustomerName" class="form-control" placeholder="Nhập họ và tên..." required />
                            </div>
                            <span asp-validation-for="CustomerName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label text-muted small fw-bold">Số Điện Thoại (SĐT) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-telephone"></i></span>
                                <input asp-for="PhoneNumber" class="form-control" placeholder="Nhập số điện thoại..." required />
                            </div>
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label text-muted small fw-bold">Địa Chỉ Nhận Hàng <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-house-door"></i></span>
                                <input asp-for="ShippingAddress" class="form-control" placeholder="Tòa nhà, tên đường, phường..." required />
                            </div>
                            <span asp-validation-for="ShippingAddress" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Products Table Box -->
                    <div class="bg-white rounded shadow-sm mb-4 border overflow-hidden">
                        <div class="p-3 bg-light border-bottom text-muted fw-bold" style="font-size: 13px;">
                            <div class="row">
                                <div class="col-6">Sản Phẩm</div>
                                <div class="col-2 text-center">Đơn Giá</div>
                                <div class="col-2 text-center">Số Lượng</div>
                                <div class="col-2 text-end">Thành Tiền</div>
                            </div>
                        </div>
                        
                        <div class="divide-y">
                            @if (cart != null && cart.Items.Any())
                            {
                                foreach (var item in cart.Items)
                                {
                                    <div class="p-3 border-bottom d-flex align-items-center" style="font-size: 14px;">
                                        <div class="row w-100 align-items-center m-0">
                                            <div class="col-6 d-flex align-items-center p-0">
                                                <div class="border rounded me-3" style="width: 50px; height: 50px; overflow: hidden; flex-shrink: 0;">
                                                    <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://cf.shopee.vn/file/687f3967b7c2fe6a134a2c11894eea4b_tn" : item.ImageUrl)" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.src='https://cf.shopee.vn/file/687f3967b7c2fe6a134a2c11894eea4b_tn';"/>
                                                </div>
                                                <div>
                                                    <a href="#" class="text-dark text-decoration-none fw-medium text-truncate-2">@item.Name</a>
                                                    <div class="text-muted small mt-1">Phân loại: Mặc định</div>
                                                </div>
                                            </div>
                                            <div class="col-2 text-center p-0">₫@item.Price.ToString("N0")</div>
                                            <div class="col-2 text-center p-0">@item.Quantity</div>
                                            <div class="col-2 text-end text-orange fw-bold p-0">₫@((item.Price * item.Quantity).ToString("N0"))</div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>

                        <!-- Notes & Delivery Info -->
                        <div class="p-3 border-top bg-light" style="background-color: #fafafa !important;">
                            <div class="row align-items-center">
                                <div class="col-md-6 mb-3 mb-md-0">
                                    <div class="d-flex align-items-center">
                                        <span class="me-3 text-muted small" style="white-space: nowrap;">Lời nhắn:</span>
                                        <input asp-for="Notes" class="form-control form-control-sm" placeholder="Lưu ý cho Người bán..." style="background: white;" />
                                    </div>
                                </div>
                                <div class="col-md-6 text-end text-muted small">
                                    Phương thức vận chuyển: <span class="fw-bold text-dark ms-1">Nhanh</span> <span class="ms-3 text-dark fw-bold">₫30,000</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Voucher & Discount Section -->
                    <div class="bg-white p-4 rounded shadow-sm mb-4 border">
                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-ticket-perforated-fill text-danger fs-4 me-2 animate-pulse"></i>
                                <h6 class="m-0 fw-bold">36TH SHOP Voucher</h6>
                            </div>
                            <div class="d-flex align-items-center gap-2" style="max-width: 400px; flex: 1;">
                                <input asp-for="VoucherCode" id="voucherInput" class="form-control form-control-sm text-uppercase" placeholder="Nhập mã voucher (Mã: 36THSHOP, GIAM10, GIAM50...)" style="font-size: 13px; font-weight: 500;" />
                                <button type="button" id="applyVoucherBtn" class="btn btn-danger btn-sm px-3" style="font-size: 13px; white-space: nowrap; background-color: var(--shopee-orange); border: none;">Áp Dụng</button>
                            </div>
                        </div>
                        <div id="voucherStatus" class="mt-2 small text-success fw-medium d-none"></div>
                    </div>

                    <!-- Payment Method Select -->
                    <div class="bg-white p-4 rounded shadow-sm mb-4 border">
                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-2">
                            <h6 class="m-0 fw-bold">Phương thức thanh toán</h6>
                            <div class="d-flex gap-2">
                                <input type="hidden" asp-for="PaymentMethod" id="paymentMethodInput" value="Tiền mặt" />
                                <button type="button" id="payCashBtn" class="btn btn-sm btn-outline-dark py-2 px-3 border-orange text-orange fw-bold" style="border-radius: 4px; font-weight: 500;">
                                    <i class="bi bi-cash me-1"></i> Thanh toán khi nhận hàng (Tiền mặt)
                                </button>
                                <button type="button" id="payQrBtn" class="btn btn-sm btn-outline-dark py-2 px-3 text-muted fw-bold" style="border-radius: 4px; font-weight: 500;">
                                    <i class="bi bi-qr-code-scan me-1"></i> Chuyển khoản / Quét mã QR
                                </button>
                            </div>
                        </div>
                        <p id="paymentMethodHelp" class="text-muted small m-0 mt-2">
                            <i class="bi bi-info-circle me-1"></i> Bạn sẽ thanh toán bằng tiền mặt cho shipper khi nhận được hàng.
                        </p>
                    </div>

                    <!-- Checkout Total Summary Box -->
                    <div class="bg-white p-4 rounded shadow-sm border" style="background-color: #fffefb !important; border-top: 1px solid #f1f0ed !important;">
                        <div class="row justify-content-end text-end">
                            <div class="col-md-5">
                                <div class="d-flex justify-content-between align-items-center mb-2 text-muted" style="font-size: 14px;">
                                    <span>Tổng tiền hàng:</span>
                                    <span class="text-dark">₫@(cart?.Items.Sum(i => i.Price * i.Quantity).ToString("N0") ?? "0")</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mb-2 text-muted" style="font-size: 14px;">
                                    <span>Phí vận chuyển:</span>
                                    <span class="text-dark">₫30,000</span>
                                </div>
                                <div id="discountRow" class="d-flex justify-content-between align-items-center mb-2 text-success d-none" style="font-size: 14px;">
                                    <span>Giảm giá Voucher:</span>
                                    <span id="discountText" class="fw-medium">-₫0</span>
                                </div>
                                <hr class="my-2">
                                <div class="d-flex justify-content-between align-items-center mb-4">
                                    <span class="text-muted" style="font-size: 16px;">Tổng thanh toán:</span>
                                    <span id="finalTotalText" class="fw-bold text-orange" style="font-size: 28px;">₫@(((cart?.Items.Sum(i => i.Price * i.Quantity) ?? 0) + 30000).ToString("N0"))</span>
                                </div>
                                <hr class="my-3">
                                <div class="d-flex justify-content-between align-items-center mt-3">
                                    <div class="text-muted text-start small me-4" style="line-height: 1.4;">
                                        Nhấn "Đặt Hàng" đồng nghĩa với việc bạn đồng ý tuân theo các điều khoản dịch vụ của shop.
                                    </div>
                                    <button type="submit" class="shopee-btn-solid-orange py-2 px-5 fs-5 shadow-sm fw-bold" style="border-radius: 4px;">Đặt Hàng</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal QR Payment Verification -->
<div class="modal fade" id="qrPaymentModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="qrPaymentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: 12px; border: none; overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.15);">
            <div class="modal-header text-white border-0 py-3" style="background-color: var(--shopee-orange) !important;">
                <h5 class="modal-title fw-bold" id="qrPaymentModalLabel"><i class="bi bi-qr-code-scan me-2"></i>Quét Mã QR Chuyển Khoản</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 text-center">
                <p class="text-muted small">Vui lòng mở ứng dụng Ngân hàng của bạn để quét mã QR bên dưới chuyển khoản trước khi hoàn tất đặt hàng.</p>
                
                <div class="bg-white p-3 d-inline-block rounded shadow-sm my-3 border border-orange">
                    <img id="modalQrImage" src="" style="max-width: 210px; height: auto;" alt="Mã QR Thanh Toán" />
                </div>
                
                <div class="mt-2 text-start bg-light p-3 rounded" style="font-size: 13px; border: 1px dashed #ddd;">
                    <div class="mb-1 text-muted">Ngân hàng: <strong class="text-dark">Sacombank</strong></div>
                    <div class="mb-1 text-muted">Chủ tài khoản: <strong class="text-dark text-uppercase">DO HUY AN</strong></div>
                    <div class="mb-1 text-muted">Số tài khoản: <strong class="text-dark">060311717378</strong></div>
                    <div class="mb-1 text-muted">Số tiền: <strong id="modalQrAmount" class="text-danger fs-5">0 ₫</strong></div>
                    <div class="mb-0 text-muted">Nội dung: <strong id="modalQrInfo" class="text-primary"></strong></div>
                </div>
                
                <div class="alert alert-warning border-0 mt-3 mb-0 py-2 text-start" style="font-size: 12px; color: #856404; background-color: #fff3cd;">
                    <i class="bi-exclamation-triangle-fill me-1"></i> <strong>Lưu ý:</strong> Vui lòng quét mã QR chuyển khoản xong mới bấm "Xác nhận đã chuyển khoản".
                </div>
            </div>
            <div class="modal-footer border-0 bg-light py-3 d-flex justify-content-between">
                <button type="button" class="btn btn-outline-secondary btn-sm px-3" data-bs-dismiss="modal">Hủy bỏ</button>
                <button type="button" id="confirmQrPaidBtn" class="btn btn-danger btn-sm px-4 fw-bold" style="background-color: var(--shopee-orange); border: none;">Xác nhận đã chuyển khoản</button>
            </div>
        </div>
    </div>
</div>

<style>
    .border-orange {
        border-color: var(--shopee-orange) !important;
        background-color: rgba(238, 77, 45, 0.04);
    }
    .text-orange {
        color: var(--shopee-orange) !important;
    }
    .text-truncate-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .animate-pulse {
        animation: pulse 2s infinite;
    }
    @@keyframes pulse {
        0% { transform: scale(1); }
        50% { transform: scale(1.1); }
        100% { transform: scale(1); }
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function() {
            var baseTotal = @(cart?.Items.Sum(i => i.Price * i.Quantity) ?? 0);
            var shippingFee = 30000;
            var discount = 0;
            var qrConfirmed = false;

            function updateSummary() {
                var finalTotal = baseTotal + shippingFee - discount;
                if (finalTotal < 0) finalTotal = 0;
                
                $('#discountText').text('-₫' + discount.toLocaleString('vi-VN'));
                $('#finalTotalText').text('₫' + finalTotal.toLocaleString('vi-VN'));
                
                if (discount > 0) {
                    $('#discountRow').removeClass('d-none');
                } else {
                    $('#discountRow').addClass('d-none');
                }
            }

            // Payment Mode Select Trigger
            $('#payCashBtn').click(function() {
                $('#paymentMethodInput').val('Tiền mặt');
                $(this).addClass('border-orange text-orange').removeClass('text-muted');
                $('#payQrBtn').addClass('text-muted').removeClass('border-orange text-orange');
                $('#paymentMethodHelp').html('<i class="bi bi-info-circle me-1"></i> Bạn sẽ thanh toán bằng tiền mặt cho shipper khi nhận được hàng.');
            });

            $('#payQrBtn').click(function() {
                $('#paymentMethodInput').val('Chuyển khoản');
                $(this).addClass('border-orange text-orange').removeClass('text-muted');
                $('#payCashBtn').addClass('text-muted').removeClass('border-orange text-orange');
                $('#paymentMethodHelp').html('<i class="bi bi-info-circle me-1"></i> Bạn sẽ thực hiện quét mã QR và chuyển khoản thành công trước khi hoàn tất đặt hàng.');
            });

            // Voucher calculation
            $('#applyVoucherBtn').click(function() {
                var code = $('#voucherInput').val().trim().toUpperCase();
                var statusDiv = $('#voucherStatus');
                
                if (code === "") {
                    discount = 0;
                    statusDiv.addClass('d-none');
                    updateSummary();
                    return;
                }

                if (code === "36THSHOP") {
                    discount = Math.round(baseTotal * 0.15); // 15% discount
                    statusDiv.text("Áp dụng mã 36THSHOP thành công: Giảm 15% (Giảm ₫" + discount.toLocaleString('vi-VN') + ")")
                             .removeClass('d-none text-danger').addClass('text-success');
                } else if (code === "GIAM10") {
                    discount = Math.round(baseTotal * 0.10); // 10% discount
                    statusDiv.text("Áp dụng mã GIAM10 thành công: Giảm 10% (Giảm ₫" + discount.toLocaleString('vi-VN') + ")")
                             .removeClass('d-none text-danger').addClass('text-success');
                } else if (code === "GIAM50") {
                    discount = Math.round(baseTotal * 0.50); // 50% discount
                    statusDiv.text("Áp dụng mã GIAM50 thành công: Giảm 50% (Giảm ₫" + discount.toLocaleString('vi-VN') + ")")
                             .removeClass('d-none text-danger').addClass('text-success');
                } else {
                    discount = 20000; // 20k flat
                    statusDiv.text("Áp dụng mã voucher " + code + " thành công: Giảm ₫" + discount.toLocaleString('vi-VN'))
                             .removeClass('d-none text-danger').addClass('text-success');
                }
                updateSummary();
            });

            if ($('#voucherInput').val().trim() !== "") {
                $('#applyVoucherBtn').click();
            }

            // Intercept checkout form submission
            $('#checkoutForm').submit(function(e) {
                var method = $('#paymentMethodInput').val();
                
                if (!$(this).valid()) {
                    return true; // Let validation display messages
                }
                
                if (method === 'Chuyển khoản' && !qrConfirmed) {
                    e.preventDefault();
                    
                    var finalAmount = baseTotal + shippingFee - discount;
                    if (finalAmount < 0) finalAmount = 0;
                    var phone = $('#PhoneNumber').val().replace(/\s+/g, '');
                    
                    var qrUrl = "https://img.vietqr.io/image/sacombank-060311717378-compact2.png?amount=" + finalAmount + "&addInfo=Thanh toan don hang " + phone + "&accountName=DO HUY AN";
                    
                    $('#modalQrImage').attr('src', qrUrl);
                    $('#modalQrAmount').text(finalAmount.toLocaleString('vi-VN') + ' ₫');
                    $('#modalQrInfo').text("Thanh toan don hang " + phone);
                    
                    $('#qrPaymentModal').modal('show');
                    return false;
                }
                
                return true;
            });

            $('#confirmQrPaidBtn').click(function() {
                qrConfirmed = true;
                $('#qrPaymentModal').modal('hide');
                $('#checkoutForm').submit();
            });
        });
    </script>
}
