@model TH_LTW_Buoi02.Models.Order
@{
    ViewData["Title"] = "Hoàn Tất Đặt Hàng";
}

<div class="container mt-5 mb-5 pb-5">
    <div class="row justify-content-center">
        <div class="col-md-9 text-center">
            <!-- Success Status Header -->
            <div class="alert alert-success shadow-sm mb-4 p-4 border-0" style="border-radius: 12px; background-color: #e6fcf5;">
                <i class="bi bi-check-circle-fill text-success" style="font-size: 3.5rem; display: inline-block; animation: scaleUp 0.5s ease-out;"></i>
                <h2 class="mt-3 fw-bold text-success">Đặt Hàng Thành Công!</h2>
                <p class="fs-5 mt-2 mb-0">Mã đơn hàng của bạn là: <strong class="text-danger">#@Model.Id</strong></p>
            </div>
            
            <div class="row">
                <!-- Left Column: Order details -->
                <div class="col-md-6 text-start mb-4">
                    <div class="card shadow-sm border-0 h-100" style="border-radius: 12px;">
                        <div class="card-body p-4">
                            <h5 class="fw-bold mb-4 text-dark border-bottom pb-2"><i class="bi bi-person-lines-fill me-2 text-primary"></i>Thông Tin Đơn Hàng</h5>
                            
                            <div class="mb-3">
                                <div class="text-muted small">Người nhận hàng:</div>
                                <div class="fw-bold text-dark fs-6">@Model.CustomerName</div>
                            </div>
                            
                            <div class="mb-3">
                                <div class="text-muted small">Số điện thoại (SĐT):</div>
                                <div class="fw-bold text-dark fs-6">@Model.PhoneNumber</div>
                            </div>
                            
                            <div class="mb-3">
                                <div class="text-muted small">Địa chỉ giao hàng:</div>
                                <div class="fw-semibold text-dark">@Model.ShippingAddress</div>
                            </div>
                            
                            <div class="mb-3">
                                <div class="text-muted small">Phương thức thanh toán:</div>
                                <div class="fw-semibold text-dark">
                                    @if (Model.PaymentMethod == "Chuyển khoản")
                                    {
                                        <span class="badge bg-primary text-white"><i class="bi bi-qr-code-scan me-1"></i> Chuyển khoản / Quét mã QR</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success text-white"><i class="bi bi-cash me-1"></i> Thanh toán tiền mặt khi nhận hàng (COD)</span>
                                    }
                                </div>
                            </div>
                            
                            @if (!string.IsNullOrEmpty(Model.VoucherCode))
                            {
                                <div class="mb-3">
                                    <div class="text-muted small">Mã Voucher đã dùng:</div>
                                    <span class="badge bg-danger text-white px-3 py-2 mt-1" style="font-size: 13px;"><i class="bi bi-ticket-perforated-fill me-1"></i>@Model.VoucherCode</span>
                                </div>
                            }
                            
                            @if (!string.IsNullOrEmpty(Model.Notes))
                            {
                                <div class="mb-3">
                                    <div class="text-muted small">Ghi chú:</div>
                                    <div class="text-muted italic">"@Model.Notes"</div>
                                </div>
                            }

                            <div class="mt-4 pt-3 border-top d-flex justify-content-between align-items-center">
                                <span class="text-muted">Tổng số tiền thanh toán:</span>
                                <span class="text-danger fw-bold fs-4">@Model.TotalPrice.ToString("N0") ₫</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Payment Details -->
                @if (Model.PaymentMethod == "Chuyển khoản")
                {
                    <div class="col-md-6 mb-4">
                        <div class="card shadow-sm border-0 h-100" style="border-radius: 12px; background-color: #f6ffed; border: 1px solid #b7eb8f !important;">
                            <div class="card-body p-4 text-center d-flex flex-column justify-content-center align-items-center">
                                <i class="bi bi-patch-check-fill text-success mb-3" style="font-size: 4.5rem; display: inline-block; animation: bounce 2s infinite;"></i>
                                <h5 class="fw-bold mb-3 text-success">Đã Thanh Toán Thành Công</h5>
                                <p class="text-muted small px-3">Hệ thống đã ghi nhận bạn quét mã QR và chuyển khoản thành công cho đơn hàng này.</p>
                                
                                <div class="bg-white p-3 rounded w-100 border text-center mt-3" style="font-size: 14px; border-color: #d9d9d9 !important;">
                                    <div class="text-muted">Số tiền đã nhận chuyển khoản:</div>
                                    <div class="text-success fw-bold fs-4 mt-1">@Model.TotalPrice.ToString("N0") ₫</div>
                                </div>
                                
                                <div class="alert alert-success border-0 mt-4 mb-0 py-2 text-start w-100" style="font-size: 12px; background-color: #f6ffed; color: #52c41a;">
                                    <i class="bi bi-shield-fill-check me-1"></i> Đơn hàng đang được chuẩn bị và sẽ giao tới địa chỉ của bạn trong thời gian sớm nhất.
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="col-md-6 mb-4">
                        <div class="card shadow-sm border-0 h-100" style="border-radius: 12px; background-color: #fbfcff; border: 1px solid #e2e8f0 !important;">
                            <div class="card-body p-4 text-center d-flex flex-column justify-content-center align-items-center">
                                <i class="bi bi-cash-stack text-success mb-3" style="font-size: 4.5rem; display: inline-block;"></i>
                                <h5 class="fw-bold mb-3 text-success">Thanh Toán Khi Nhận Hàng (COD)</h5>
                                <p class="text-muted small px-3">Bạn đã chọn phương thức thanh toán bằng tiền mặt khi nhận hàng. Vui lòng chuẩn bị sẵn số tiền thanh toán cho shipper khi đơn hàng được giao đến.</p>
                                
                                <div class="bg-light p-3 rounded w-100 border text-center mt-3" style="font-size: 14px;">
                                    <div class="text-muted">Tổng số tiền cần thanh toán cho shipper:</div>
                                    <div class="text-danger fw-bold fs-4 mt-1">@Model.TotalPrice.ToString("N0") ₫</div>
                                </div>
                                
                                <div class="alert alert-info border-0 mt-4 mb-0 py-2 text-start w-100" style="font-size: 12px;">
                                    <i class="bi bi-info-circle-fill me-1"></i> <strong>Lưu ý:</strong> Shipper sẽ liên hệ trước với bạn qua số điện thoại <strong>@Model.PhoneNumber</strong> để hẹn thời gian giao nhận.
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="mt-4">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-5 py-2 fw-bold" style="border-radius: 8px; background-color: var(--shopee-orange); border: none;"><i class="bi bi-house-door-fill me-2"></i>Quay Về Trang Chủ Mua Sắm</a>
            </div>
        </div>
    </div>
</div>

<style>
    .border-orange {
        border-color: rgba(238, 77, 45, 0.2) !important;
    }
    .text-orange {
        color: var(--shopee-orange) !important;
    }
    @@keyframes scaleUp {
        0% { transform: scale(0.5); opacity: 0; }
        100% { transform: scale(1); opacity: 1; }
    }
</style>
